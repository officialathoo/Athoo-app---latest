FROM node:22-bookworm-slim AS node-runtime

FROM clamav/clamav:1.4.5-debian13-slim

USER root

COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node

RUN node --version \
  && clamd --version \
  && freshclam --version

WORKDIR /opt/athoo-scanner

COPY services/upload-scanner/server.mjs ./server.mjs
COPY services/upload-scanner/entrypoint.sh ./entrypoint.sh
COPY services/upload-scanner/clamd.conf /etc/clamav/clamd.conf

RUN chmod 0755 ./entrypoint.sh \
  && mkdir -p /var/run/clamav /var/lib/clamav \
  && chown -R clamav:clamav /var/run/clamav /var/lib/clamav

ENV NODE_ENV=production \
    PORT=8080 \
    CLAMD_HOST=127.0.0.1 \
    CLAMD_PORT=3310 \
    SCANNER_MAX_BYTES=209715200 \
    SCANNER_MAX_CONCURRENCY=2 \
    SCANNER_TIMEOUT_MS=120000

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=8s --start-period=180s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8080/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/opt/athoo-scanner/entrypoint.sh"]